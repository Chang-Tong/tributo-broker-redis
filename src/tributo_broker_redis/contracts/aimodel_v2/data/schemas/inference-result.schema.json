{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tributo.dev/contracts/aimodel-v2/inference-result.schema.json",
  "type": "object",
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "inferred_at": {
      "type": "string",
      "minLength": 1
    },
    "pred_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pred_probability": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "pred_probabilities": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pred_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "pred_extra": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "execution_id",
    "model_id",
    "version_id",
    "tenant_id",
    "entity_id",
    "inferred_at",
    "pred_label",
    "pred_probability",
    "pred_probabilities",
    "pred_value",
    "pred_extra"
  ],
  "additionalProperties": true
}
